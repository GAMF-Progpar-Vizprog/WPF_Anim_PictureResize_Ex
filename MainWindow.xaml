<Window x:Class="PictureResize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PictureResize"
        mc:Ignorable="d"
        Title="Simple size changing animation" Height="238" Width="301">
	<Grid>
		<Border Width="244" Height="184" BorderThickness="2" BorderBrush="#FFDE3333">
			<Image Height="150" x:Name="imImage" Stretch="Fill" Width="200"  
							 MouseEnter="imImage_MouseEnter" 
							 MouseLeave="imImage_MouseLeave" 
							 HorizontalAlignment="Center" 
							 VerticalAlignment="Center" 
							 Source="HPIM3481.JPG" />
		</Border>
	</Grid>

</Window>
